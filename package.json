{
  "name": "redline-desktop",
  "productName": "Redline",
  "version": "0.5.6",
  "description": "Redline for the desktop: your day, to-dos, lists, notes, money, dates, car, things and the assistant, in sync with the phone.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Redline",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "node test/e2e/run.js",
    "sync-core": "sh scripts/sync-core.sh",
    "icons": "node scripts/icons.js",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:portable": "npm run build && electron-builder --win portable zip",
    "dist:mac": "npm run build && electron-builder --mac",
    "perf": "node test/perf/run.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resedit": "^3.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "zustand": "^5.1.0"
  }
}
